# Insider Scanner environment template.
#
# deploy.sh --setup copies this to .env on first run and then stops, because the
# required values below cannot be guessed. Fill them in and re-run.
#
# Every variable the code reads is listed here; tests/test_deploy_manifest.py
# fails if code starts reading one that is missing from this file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL DSN. Required by the app, the ingester, Alembic, and the backup
# script. ingest.py does not call load_dotenv, so systemd units export it.
DATABASE_URL=postgresql://user:pass@localhost:5432/insider_tracker

# Dashboard credentials. Enforced by the app (BasicAuthMiddleware) and by nginx,
# which forwards Authorization upstream so one pair satisfies both layers.
# The app fails closed with a 503 when these are unset, so set them BEFORE
# deploying or the live site goes down.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# HMAC key for CSRF tokens. Generate with: openssl rand -hex 32
# Must be identical across both uvicorn workers, so never generate it per
# process: the workers would reject each other's tokens.
SECRET_KEY=

# ---------------------------------------------------------------------------
# Alerting and integrations
# ---------------------------------------------------------------------------

SLACK_WEBHOOK_URL=
POLYGON_API_KEY=
AINVEST_API_KEY=

# Claude API key for auto_diagnose.py. Without it the webhook still fires but
# only reports that manual investigation is needed.
ANTHROPIC_API_KEY=

# Shared secret for POST /webhook/alert (X-Webhook-Secret header). The route
# returns 503 when unset rather than accepting unauthenticated calls.
WEBHOOK_SECRET=

# Wisepub SSO JWT secret. Must match the "JWT Secret" on SSO Site record 5.
WISEPUB_SSO_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Base URL used in Slack alert links. Defaults to the production URL.
ALERT_BASE_URL=

# PgBouncer DSN. When set, the app pools through it instead of connecting
# directly to PostgreSQL.
PGBOUNCER_URL=

# Signing key for the Redis pickle cache. Falls back to DATABASE_URL when unset,
# which is deliberate: it is already required, so there is no new-variable
# footgun. Must be stable across workers for the same reason as SECRET_KEY.
CACHE_SIGNING_KEY=

# Rate-limit counter storage. Defaults to Redis db=4, kept separate from the
# cache on db=3 whose invalidation helpers scan by key prefix. Leave unset in
# normal deployments. slowapi's own default is in-process memory, which would
# mean each uvicorn worker enforced its own copy of every limit, so the real
# ceiling became (limit x workers) and reset on every restart.
RATE_LIMIT_STORAGE_URI=

# Heartbeat URLs (UptimeRobot or similar). Pinged only on a clean run.
INGEST_HEARTBEAT_URL=
PRICES_HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=

# ---------------------------------------------------------------------------
# Nightly backup to DigitalOcean Spaces (scripts/backup_postgres.py)
# ---------------------------------------------------------------------------

BACKUP_S3_BUCKET=opi-insider-backups
BACKUP_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
